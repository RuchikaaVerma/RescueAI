# ── Local development ────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
VITE_API_BASE_URL=http://localhost:8081
VITE_WS_URL=http://localhost:8081

# ── AI / ML ──────────────────────────────────────────────────────────
# Google Gemini AI — free API key at https://aistudio.google.com/
# When set, the agent pipeline runs real Gemini 2.0 Flash analysis.
# When absent, the app falls back to realistic mock simulation.
VITE_GEMINI_API_KEY=

# ── Weather ───────────────────────────────────────────────────────────
# OpenWeatherMap — free API key at https://openweathermap.org/api
# Free tier: 1,000 calls/day. Without this key, demo weather data is shown.
VITE_WEATHER_API_KEY=

# ── Render deployment ────────────────────────────────────────────────
# Set these as Environment Variables in your Render Static Site settings.
# VITE_API_BASE_URL=https://rescueai-backend.onrender.com
# VITE_WS_URL=https://rescueai-backend.onrender.com
