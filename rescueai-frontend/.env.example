# ── Local development ────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
VITE_API_BASE_URL=http://localhost:8081
VITE_WS_URL=http://localhost:8081

# ── Render deployment ────────────────────────────────────────────────
# Set these as Environment Variables in your Render Static Site settings.
# Replace with your actual Render backend URL, e.g.:
# VITE_API_BASE_URL=https://rescueai-backend.onrender.com
# VITE_WS_URL=https://rescueai-backend.onrender.com
