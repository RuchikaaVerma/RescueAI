# Copy to .env and fill in before `docker compose up`

# --- AI provider (Phase 1: hosted; switch to ollama for local models in Phase 2) ---
AI_PROVIDER=openai
AI_API_KEY=your-gemini-or-openai-api-key-here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-1.5-flash

# --- Local model alternative (Phase 2 research) ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string-in-production
